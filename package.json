    "gate:2": "tsx --env-file=.env scripts/src/gate2.ts",
    "gate:3": "tsx --env-file=.env scripts/src/gate3.ts",
    "gate:4": "tsx --env-file=.env scripts/src/gate4.ts",
    "gate:5": "tsx --env-file=.env scripts/src/gate5.ts",
    "gate:6": "tsx --env-file=.env scripts/src/gate6.ts",
    "gate:7": "tsx --env-file=.env scripts/src/gate7.ts",
    "gate:8": "tsx --env-file=.env scripts/src/gate8.ts",
    "gate:9": "tsx --env-file=.env scripts/src/gate9.ts",
    "gate:10": "tsx --env-file=.env scripts/src/gate10.ts",
    "gate:10b": "tsx --env-file=.env scripts/src/gate10b.ts",
    "gate:11": "tsx --env-file=.env scripts/src/gate11.ts",
    "gate:11e": "tsx --env-file=.env scripts/src/gate11e.ts",
    "gate:11f": "tsx --env-file=.env scripts/src/gate11f.ts",
    "gate:11g": "tsx --env-file=.env scripts/src/gate11g.ts",
    "gate:11h": "tsx --env-file=.env scripts/src/gate11h.ts",
    "gate:12": "tsx --env-file=.env scripts/src/gate12.ts",
    "gate:all": "tsx --env-file=.env scripts/src/gate-all.ts",
    "db:init": "tsx scripts/src/init-db.ts",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
