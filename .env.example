# Waypoint — environment variables
# Copy to .env and fill in real values.
# NEVER commit .env. All secrets go in host env vars for production.

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── CORS / public URL ────────────────────────────────────────────────────────
# PUBLIC_URL is the externally reachable base URL (used in logs, links).
CORS_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:3000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local: directConnection=true is required for single-node replica sets.
# Production: replace with Atlas M0 connection string (no directConnection).
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=waypoint

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Comma-separated list of API keys accepted on write routes.
API_KEYS=dev-key-change-me

# ─── LLM narration ────────────────────────────────────────────────────────────
# Set LLM_ENABLED=true to activate narration.
# LLM_BASE_URL must be an OpenAI-compatible endpoint.
# Works with Ollama (http://localhost:11434/v1), Groq, or Gemini.
LLM_ENABLED=false
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b

# ─── Embeddings ───────────────────────────────────────────────────────────────
# EMBED_PROVIDER: voyage | ollama | none
# EMBED_DIM must match the model's output dimension.
EMBED_PROVIDER=none
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
EMBED_DIM=1024

# ─── Contract mining & Incident detection ────────────────────────────────────
MIN_BASELINE_RUNS=10
CONTRACT_MIN_SUPPORT=0.98
DETECT_WINDOW=20
DETECT_THRESHOLD=0.3
DETECT_MIN_RUNS=8

# ─── Live stream & public dashboard access ────────────────────────────────────
READ_PUBLIC_PROJECTS=demo,invoice-demo
MAX_SSE_CLIENTS=50

# ─── Background worker ────────────────────────────────────────────────────────
WORKER_ENABLED=false

# ─── Gate 4 (production deploy check) ────────────────────────────────────────
# Set these ONLY when running pnpm gate:4 against a live deployment.
# BASE_URL is the public URL of the deployed server.
# API_KEY is ONE of the production API_KEYS (no trailing comma).
BASE_URL=
API_KEY=
