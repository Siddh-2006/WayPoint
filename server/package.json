{
  "name": "@waypoint/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --env-file=../../.env watch src/index.ts",
    "build": "tsc && node -e \"const fs = require('node:fs'); fs.mkdirSync('dist/demo', { recursive: true }); fs.copyFileSync('src/demo/corpus.json', 'dist/demo/corpus.json');\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^10.1.8",
    "diff": "^9.0.0",
    "fastify": "^5.2.0",
    "mongodb": "^6.12.0",
    "pino-pretty": "^13.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
